# Groq API key (server-side only; NEVER expose to the browser)
GROQ_API_KEY=your_groq_api_key_here

# Public site URL (used for canonical URLs only; it is not a secret)
PUBLIC_SITE_URL=http://localhost:3000

# Configure GROQ_API_KEY only in the server-side environment settings.
# Never prefix this key with VITE_ or expose it in frontend code.