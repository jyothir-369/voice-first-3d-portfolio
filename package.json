{
  "name": "voice-portfolio",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Talk to My Work - Voice-first 3D portfolio",
  "scripts": {
    "dev": "vite",
    "validate-content": "node scripts/validate-content.mjs",
    "prebuild": "npm run validate-content",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 5",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "openai": "^7.62.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/three": "0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/ui": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.0",
    "prettier": "3.3.3",
    "terser": "^5.51.2",
    "typescript": "5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "24.15.x",
    "npm": ">=10.0.0"
  }
}
