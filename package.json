{
  "name": "voice-portfolio",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Talk to My Work - Voice-first 3D portfolio",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 5",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@types/node": "22.7.5",
    "@types/three": "0.169.0",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "@vitest/ui": "2.1.2",
    "eslint": "9.12.0",
    "jsdom": "^31.0.0",
    "prettier": "3.3.3",
    "terser": "^5.51.2",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
